# ---------- Backend ----------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite by default; docker-compose overrides with PostgreSQL
DATABASE_URL=sqlite:///./data/app.db
AUTO_CREATE_TABLES=true
AUTO_SEED=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=10

# Embeddings: auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM provider for feedback: none | openai | ollama
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# For Ollama Cloud: OLLAMA_BASE_URL=https://ollama.com, OLLAMA_MODEL=gpt-oss:20b, and set your key here
OLLAMA_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Match score weights (normalized automatically)
WEIGHT_SEMANTIC=0.35
WEIGHT_SKILLS=0.35
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10
WEIGHT_TITLE=0.05

# ---------- Frontend ----------
# Leave empty so the browser calls /api on the same origin (Next.js proxies it to BACKEND_URL).
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000
