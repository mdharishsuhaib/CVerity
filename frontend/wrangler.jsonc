{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers & Pages > your Worker).
  "name": "cverity",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cverity"
    }
  ],
  // Keep variables set in the dashboard instead of wiping them on every deploy.
  "keep_vars": true,
  // Runtime variables for the Worker. BACKEND_URL is where /api/* is proxied (the Render backend).
  // It is not a secret (browsers can see which API they talk to), so it lives here and ships with every deploy.
  "vars": {
    "BACKEND_URL": "https://cverity-api.onrender.com"
  },
  // Serve on https://cverity.<subdomain>.workers.dev and give each non-production upload its own preview URL.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
